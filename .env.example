# Copy to .env and fill in. .env is ignored by git.

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Extra origins for forms behind a proxy, like https://nonstoppdx.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# PostgreSQL
POSTGRES_DB=nonstoppdx
POSTGRES_USER=nonstoppdx
POSTGRES_PASSWORD=change-me

# Where the site listens on the host. Keep it on 127.0.0.1 unless you want it on your network.
WEB_BIND=127.0.0.1:8000

# How often the scheduler runs the syncs, in hours (168 is weekly)
SYNC_INTERVAL_HOURS=168

# OpenSky API client, for the weekly departures check
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
