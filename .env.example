# Copy to .env and fill in. .env is ignored by git.

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Extra origins for forms behind a proxy, like https://nonstoppdx.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# PostgreSQL
POSTGRES_DB=nonstoppdx
POSTGRES_USER=nonstoppdx
POSTGRES_PASSWORD=change-me

# Where the site listens on the host. Keep it on 127.0.0.1 unless you want it on your network.
WEB_BIND=127.0.0.1:8000

# How often the scheduler runs the syncs, in hours (168 is weekly)
SYNC_INTERVAL_HOURS=168

# OpenSky API client, for the weekly departures check
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# FAA SWIM trial, from the subscription's JMS connection details in the SCDS portal.
SWIM_URL=
SWIM_VPN=
SWIM_CONNECTION_FACTORY=
SWIM_USERNAME=
SWIM_PASSWORD=
SWIM_QUEUE=

# Cloudflare Tunnel token for nonstoppdx.com (Zero Trust, Networks, Tunnels). Only the token, not the install command.
CLOUDFLARE_TUNNEL_TOKEN=
# When the site is reached through the domain, add it here (comma separated) and keep DJANGO_DEBUG=0.
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,192.168.0.100,nonstoppdx.com,www.nonstoppdx.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://nonstoppdx.com,https://www.nonstoppdx.com
# 1 = template edits show without a restart (development).
DJANGO_TEMPLATE_RELOAD=0
# 1 = cookies only over HTTPS. Turn on once logins only happen through the domain.
DJANGO_SECURE_COOKIES=0
